{
  "name": "mcp-clickup",
  "version": "0.1.0",
  "description": "Open-source MCP server for ClickUp — manage tasks, lists, and projects from AI agents",
  "type": "module",
  "bin": {
    "mcp-clickup": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": ["mcp", "clickup", "task-management", "automation", "ai", "model-context-protocol"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "msw": "^2.7.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
